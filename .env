# Required
API_KEY=sk_live_4f3b2a9e8c1d4f7a9b6c0d2e

# Server
PORT=3000

# Database
DB_DRIVER=sqlite
DB_DSN=/app/data/whatsapp.db

# Queue / Anti-Ban (Layer 1)
QUEUE_BASE_DELAY=4s
QUEUE_JITTER_MIN=1s
QUEUE_JITTER_MAX=3s
MAX_MESSAGES_PER_MINUTE=20

# Typing Simulation (Anti-Ban Layer 2)
TYPING_ENABLED=true
TYPING_CHARS_PER_SECOND=12

# Presence Simulation
PRESENCE_ENABLED=true

# Webhook
WEBHOOK_TIMEOUT=10s
WEBHOOK_MAX_RETRIES=5

# Media storage
MEDIA_STORAGE_PATH=/app/data/media

# Optional JWT Authentication
JWT_ENABLED=false
JWT_SECRET=change-me-to-a-long-random-secret
